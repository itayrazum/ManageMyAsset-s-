# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
CLAUDE_API=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: LangSmith tracing (observability). Uncomment and add a key to enable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=managemyassets

# Optional tuning
# USE_JUDGE=false            # enable the LLM judge (evaluator-optimizer)
# RESPONDER_TEMPERATURE=0.4  # warmth of the answer writer
# HISTORY_WINDOW=8           # router memory: recent messages kept (~2 per turn)
